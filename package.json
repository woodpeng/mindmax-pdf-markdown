{
  "name": "@mindmax/pdf-markdown",
  "version": "0.1.0",
  "description": "PDF → Markdown that rebuilds structure: headings, columns, tables, lists and links. Zero dependencies, runs in Node and the browser.",
  "keywords": [
    "pdf",
    "markdown",
    "pdf-to-markdown",
    "pdf2md",
    "text-extraction",
    "pdfjs",
    "llm",
    "rag",
    "converter"
  ],
  "license": "Apache-2.0",
  "author": "MindMax",
  "homepage": "https://mindmax.me/tools/pdf-to-markdown/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woodpeng/mindmax-pdf-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/woodpeng/mindmax-pdf-markdown/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "eval": "tsx eval/run.ts",
    "example:node": "tsx examples/node/cli.ts",
    "attribution": "node scripts/gen-attribution.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:pkg": "publint && attw --pack .",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "pdfjs-dist": "^6.1.200",
    "publint": "^0.3.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
